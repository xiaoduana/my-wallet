{
  "manifest_version": 3,
  "name": "my Wallet",
  "version": "1.0.0",
  "permissions": [
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "inject.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "inject.js",
        "images/*"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}